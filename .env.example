# ========== Vercel Environment Variables (필수/선택) ==========
# Vercel → Project → Settings → Environment Variables 에 동일 키로 등록

# [필수] 실제 배포 도메인 (끝 슬래시 없이)
NEXT_PUBLIC_SITE_URL=https://sesan.agapet.co.kr

# [필수] 관리자 로그인 JWT 서명 비밀키 (임의 긴 문자열)
ADMIN_JWT_SECRET=여기에-긴-랜덤문자열

# [필수] IndexNow 키 — public/{키}.txt 파일 내용과 반드시 동일
INDEXNOW_KEY=f4e8fb3912a5d6f628c4255cc466f799

# [필수] Vercel Blob 스토어 연결 후 자동 발급되는 토큰
# Storage → Blob → 토큰 복사 (vercel_blob_rw_... 형태)
BLOB_READ_WRITE_TOKEN=

# [선택] 관리자에서 Gemini AI 발행 쓸 때만
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
